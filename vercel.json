{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/crm",
      "destination": "/labs/builder",
      "permanent": false
    },
    {
      "source": "/crm.html",
      "destination": "/labs/builder",
      "permanent": false
    },
    {
      "source": "/labs/crm",
      "destination": "/labs/builder",
      "permanent": false
    },
    {
      "source": "/labs/crm/:path*",
      "destination": "/labs/builder",
      "permanent": false
    },
    {
      "source": "/labs/production",
      "destination": "/labs/builder",
      "permanent": false
    },
    {
      "source": "/labs/production/:path*",
      "destination": "/labs/builder",
      "permanent": false
    },
    {
      "source": "/labs/panel-intel",
      "destination": "/labs/builder",
      "permanent": false
    },
    {
      "source": "/labs/panel-intel/:path*",
      "destination": "/labs/builder",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/labs/builder",
      "destination": "https://rollable-labs-builder.vercel.app/labs/builder"
    },
    {
      "source": "/labs/builder/:path*",
      "destination": "https://rollable-labs-builder.vercel.app/labs/builder/:path*"
    }
  ]
}
